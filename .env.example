# ---------------------------------------------------------------------------
# Copy to .env  —  every value below is optional.
# With an empty .env the pipeline still runs end to end using the
# deterministic template advisor and the on-disk vector store fallback.
# ---------------------------------------------------------------------------

# --- LLM (free tiers only) -------------------------------------------------
# groq | gemini | template | auto   (auto = use whichever key is present)
LLM_PROVIDER=auto

# https://console.groq.com/keys  — free tier
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# https://aistudio.google.com/apikey  — free tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1800
LLM_TIMEOUT_SECONDS=60

# --- Vector store ----------------------------------------------------------
# Blank => the on-disk vector store in ./storage, which needs no Docker.
# To use pgvector: `docker compose up -d postgres`, then uncomment the line below
# and re-run scripts/ingest_knowledge.py
DATABASE_URL=
# DATABASE_URL=postgresql+psycopg2://agro:agro@localhost:5432/agro
PGVECTOR_TABLE=agro_knowledge

# --- Embeddings (local, free) ---------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Vision ----------------------------------------------------------------
CHECKPOINT_PATH=models/checkpoints/resnet50_plantvillage.pt
DEVICE=auto
# Predictions below this are shown as "Possibly ..." with a low-confidence warning.
# Lab test photos score above 0.80 in 99.6 % of cases; unfamiliar field photos often do not.
CLASSIFIER_CONFIDENCE_FLOOR=0.80
# Average each prediction with its mirror image. Doubles inference cost; on the
# PlantVillage test split it measured no gain (99.73 % vs 99.75 %), so it is off.
CLASSIFIER_TTA=false

# --- Retrieval -------------------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_KEEP=4

# --- App -------------------------------------------------------------------
LOG_LEVEL=INFO
